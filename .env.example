DEBUG=1
SECRET_KEY=change-me-in-production
DATABASE_URL=postgres://postgres:postgres@db:5432/postgres
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Produção (docker-compose.prod.yml) ---
# Com DEBUG=0 a aplicação recusa subir se SECRET_KEY continuar sendo a chave de
# desenvolvimento. Gere uma nova com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Origens confiáveis para o CSRF, com esquema. Obrigatório atrás de proxy HTTPS.
CSRF_TRUSTED_ORIGINS=https://reservas.exemplo.mp.br
# Deixe 0 se o TLS termina em um proxy que não encaminha X-Forwarded-Proto,
# caso contrário o redirect para https entra em loop.
SECURE_SSL_REDIRECT=True
# Comece baixo (ex.: 3600) e só aumente depois de confirmar HTTPS em todo o
# domínio — HSTS não é reversível no navegador de quem já acessou.
SECURE_HSTS_SECONDS=31536000
# Senha do Postgres usada pelo serviço db em produção.
POSTGRES_PASSWORD=troque-esta-senha
# Senha padrão para usuários de demonstração criados pelo comando seed_data
SEED_DEFAULT_PASSWORD=reserva123

# Serviços de IA (Groq) — necessário para os endpoints em /api/v1/ai/
# Crie uma chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=
# llama-3.3-70b-versatile foi desligado pela Groq em 16/08/2026 (404 model_not_found).
# groq/compound estoura o payload do RAG (413 request_too_large) e pode buscar na web.
# qwen/qwen3.6-27b quebra o JSON da busca de salas e devolve raciocínio em <think>.
# openai/gpt-oss-120b é o substituto oficial e funciona no JSON e no assistente documental.
GROQ_MODEL=openai/gpt-oss-120b

# Base de conhecimento / RAG
# O modelo de embedding roda local via fastembed, sem chave de API.
# Trocar por modelo com outra dimensionalidade exige nova migration.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=5

# Nível de log (DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=INFO
