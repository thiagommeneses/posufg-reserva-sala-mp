DEBUG=1
SECRET_KEY=change-me-in-production
DATABASE_URL=postgres://postgres:postgres@db:5432/postgres
ALLOWED_HOSTS=localhost,127.0.0.1
# Senha padrão para usuários de demonstração criados pelo comando seed_data
SEED_DEFAULT_PASSWORD=reserva123

# Serviços de IA (Groq) — necessário para os endpoints em /api/v1/ai/
# Crie uma chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=
# llama-3.3-70b-versatile foi desligado pela Groq em 16/08/2026 (404 model_not_found).
# groq/compound estoura o payload do RAG (413 request_too_large) e pode buscar na web.
# qwen/qwen3.6-27b quebra o JSON da busca de salas e devolve raciocínio em <think>.
# openai/gpt-oss-120b é o substituto oficial e funciona no JSON e no assistente documental.
GROQ_MODEL=openai/gpt-oss-120b

# Base de conhecimento / RAG
# O modelo de embedding roda local via fastembed, sem chave de API.
# Trocar por modelo com outra dimensionalidade exige nova migration.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=5

# Nível de log (DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=INFO
