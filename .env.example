DEBUG=1
SECRET_KEY=change-me-in-production
DATABASE_URL=postgres://postgres:postgres@db:5432/postgres
ALLOWED_HOSTS=localhost,127.0.0.1
# Senha padrão para usuários de demonstração criados pelo comando seed_data
SEED_DEFAULT_PASSWORD=reserva123

# Serviços de IA (Groq) — necessário para os endpoints em /api/v1/ai/
# Crie uma chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Nível de log (DEBUG, INFO, WARNING, ERROR)
DJANGO_LOG_LEVEL=INFO
